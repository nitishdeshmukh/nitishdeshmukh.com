# Canonical site URL
NEXT_PUBLIC_APP_URL=https://acme.com

# Direct link to latest downloadable resume / CV PDF
NEXT_PUBLIC_CV_URL=https://github.com/nitishdeshmukh/resume/releases/latest/download/Nitish_Deshmukh_Resume.pdf

# Cal.com meeting booking embed (https://cal.com)
NEXT_PUBLIC_CAL_NAMESPACE=
NEXT_PUBLIC_CAL_LINK=

# GitHub API Token for repository star count (no scopes needed)
# https://github.com/settings/tokens
GITHUB_API_TOKEN=

# GitHub contributions calendar graph on home page
# https://github.com/grubersjoe/github-contributions-api
NEXT_PUBLIC_GITHUB_CONTRIBUTIONS_API_URL=https://github-contributions-api.jogruber.de/v4

# OpenPanel Analytics (https://openpanel.dev)
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=
OPENPANEL_PROJECT_ID=
OPENPANEL_CLIENT_ID=
OPENPANEL_CLIENT_SECRET=

# Cloudflare R2 Object Storage (used by `bun run capture:sync` to publish screenshots)
# https://dash.cloudflare.com/?to=/:account/r2/api-tokens
# S3 API endpoint, e.g. https://<account_id>.r2.cloudflarestorage.com
R2_S3_API=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
